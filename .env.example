# Backend-only. No live calls unless explicitly enabled. Never use VITE_ for secrets.
# Optional: select a private file explicitly with MFT_ENV_FILE=/absolute/path/.env.
# tools/start_release.py uses backend/.env.local if present; otherwise select MFT_ENV_FILE. Process settings win; file values are literal, never shell code.
AI_ENABLED=false
AI_TIMEOUT_SECONDS=30
AI_MAX_CONCURRENCY=2
SEGMENTATION_PROVIDER=disabled
SEGMENTATION_ENDPOINT_URL=
SEGMENTATION_AUTH_TOKEN=
SEGMENTATION_MODEL_ID=
# Legacy segmentation settings are not used by the automatic public workflow.
SEGMENTATION_AUTH_MODE=
SEGMENTATION_AUTH_HEADER=Authorization
SEGMENTATION_AUTH_PREFIX=
SEGMENTATION_SUPPORTS_POINTS=false
SEGMENTATION_SUPPORTS_BOXES=false
RECOMMENDATION_PROVIDER=baseten
RECOMMENDATION_ENDPOINT_URL=
# Baseten reads BASETEN_API_KEY; no token belongs in the frontend.
RECOMMENDATION_AUTH_TOKEN=
RECOMMENDATION_MODEL_ID=
RECOMMENDATION_AUTH_MODE=
RECOMMENDATION_AUTH_HEADER=Authorization
RECOMMENDATION_AUTH_PREFIX=
# The public AI flow uses the existing Baseten OpenAI-compatible adapter.
RECOMMENDATION_PROTOCOL=openai

# Optional process-local response cache; 0 disables, maximum 300 seconds.
AI_CACHE_TTL_SECONDS=0

# Stage 05 single-service release settings. PORT is supplied by many hosts.
PORT=8000
# Local only; Docker and Render explicitly bind 0.0.0.0.
BIND_HOST=127.0.0.1
REQUIRE_FRONTEND=true
# Empty uses repository frontend/dist; Docker sets /app/frontend/dist.
# FRONTEND_DIST=/absolute/path/to/frontend/dist
# Empty = same-origin only. Optional comma-separated exact origins, no wildcard.
CORS_ORIGINS=
GEOMETRY_MAX_CONCURRENCY=2
EXPENSIVE_REQUESTS_PER_MINUTE=60
AI_REQUESTS_PER_MINUTE=10
REQUEST_BODY_TIMEOUT_SECONDS=15

# Stage 04B Baseten hackathon activation (backend environment only).
BASETEN_API_KEY=
RECOMMENDATION_MAX_TOKENS=512
# Keep AI_ENABLED=false until approving image analysis and recommendation requests.
# Image analysis uses <=1024px JPEG, <=1 MiB, 1024 completion tokens, reasoning low.
# No automatic retries; Photo-only detection makes no external inference request.
# Set RECOMMENDATION_PROVIDER=baseten; empty URL/model use these exact defaults:
# RECOMMENDATION_ENDPOINT_URL=https://inference.baseten.co/v1/chat/completions
# RECOMMENDATION_MODEL_ID=meta-models/muse-spark-open-1026
# RECOMMENDATION_PROTOCOL=openai
# SEGMENTATION_PROVIDER=disabled; OpenCV extracts pixel contours locally.
# Explicit one-request CLI gate; normal tests never set this or perform inference.
LIVE_AI_TEST=0
